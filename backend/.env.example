# Court Order & Payment Agreement Defaulter App - Backend Environment

# Application
APP_NAME="Court Order & Payment Agreement Defaulter App"
DATABASE_URL="sqlite:///./defaulter.db"
# For Supabase PostgreSQL, use:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Google Gemini API Key (optional, for OCR & unstructured document extraction)
GEMINI_API_KEY=""

# Supabase Credentials (optional cloud integration)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
